@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>
            Admin Dashboard
        </h2>

        <p class="text-muted mb-0">
            Manage doctors, patients and prescriptions
        </p>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Doctors
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.DoctorCount
                            </h2>

                        </div>

                        <div class="rounded-circle bg-success-subtle
                            text-success
                            d-flex align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-person-badge fs-3"></i>

                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-controller="Doctor"
                       asp-action="Index"
                       class="text-decoration-none">

                        View Doctors
                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Patients
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.PatientCount
                            </h2>

                        </div>

                        <div class="rounded-circle bg-primary-subtle
                            text-primary
                            d-flex align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-people fs-3"></i>

                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-controller="Patient"
                       asp-action="Index"
                       class="text-decoration-none">

                        View Patients
                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Prescriptions
                            </p>

                            <h2 class="fw-bold mb-0">
                                @ViewBag.PrescriptionCount
                            </h2>

                        </div>

                        <div class="rounded-circle bg-info-subtle
                            text-info
                            d-flex align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-file-medical fs-3"></i>

                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white border-0">

                    <a asp-controller="Prescription"
                       asp-action="Index"
                       class="text-decoration-none">

                        View Prescriptions
                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-lightning-charge text-warning me-2"></i>

                Quick Actions

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3">


                <div class="col-md-4">

                    <a asp-controller="Doctor"
                       asp-action="Create"
                       class="text-decoration-none">

                        <div class="border rounded p-4 h-100
                            d-flex align-items-center">

                            <div class="rounded-circle
                                bg-success-subtle
                                text-success
                                d-flex align-items-center
                                justify-content-center me-3"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-person-plus fs-4"></i>

                            </div>

                            <div>

                                <h6 class="fw-semibold mb-1">
                                    Create Doctor
                                </h6>

                                <small class="text-muted">
                                    Add a new doctor
                                </small>

                            </div>

                        </div>

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-controller="Patient"
                       asp-action="Create"
                       class="text-decoration-none">

                        <div class="border rounded p-4 h-100
                            d-flex align-items-center">

                            <div class="rounded-circle
                                bg-primary-subtle
                                text-primary
                                d-flex align-items-center
                                justify-content-center me-3"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-person-plus fs-4"></i>

                            </div>

                            <div>

                                <h6 class="fw-semibold mb-1">
                                    Create Patient
                                </h6>

                                <small class="text-muted">
                                    Add a new patient
                                </small>

                            </div>

                        </div>

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-controller="Prescription"
                       asp-action="Create"
                       class="text-decoration-none">

                        <div class="border rounded p-4 h-100
                            d-flex align-items-center">

                            <div class="rounded-circle
                                bg-info-subtle
                                text-info
                                d-flex align-items-center
                                justify-content-center me-3"
                                 style="width:50px;height:50px;">

                                <i class="bi bi-file-medical fs-4"></i>

                            </div>

                            <div>

                                <h6 class="fw-semibold mb-1">
                                    Create Prescription
                                </h6>

                                <small class="text-muted">
                                    Create a new prescription
                                </small>

                            </div>

                        </div>

                    </a>

                </div>


            </div>

        </div>

    </div>

</div>