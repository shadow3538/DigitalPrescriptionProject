@{
    ViewData["Title"] = "Privacy & Data Protection";
}

<div class="container-fluid py-4">


    <div class="mb-4">

        <div class="d-flex align-items-center mb-2">

            <div class="bg-primary-subtle
                        text-primary
                        rounded-circle
                        d-flex
                        align-items-center
                        justify-content-center
                        me-3"
                 style="width:55px;height:55px;">

                <i class="bi bi-shield-lock fs-4"></i>

            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    Privacy & Data Protection
                </h2>

                <p class="text-muted mb-0">
                    How Digital Prescription System handles
                    user and medical information
                </p>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-info-circle text-primary me-2"></i>

                About Your Privacy

            </h5>

            <p class="text-muted mb-0">

                Digital Prescription System is designed to
                manage doctors, patients and digital
                prescriptions in a controlled and secure
                environment.

                Access to information is restricted according
                to the user's assigned role and permissions.

            </p>

        </div>

    </div>



    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">

                <i class="bi bi-database text-primary me-2"></i>

                Information Managed by the System

            </h5>


            <div class="row g-4">



                <div class="col-md-6 col-lg-3">

                    <div class="privacy-item h-100">

                        <div class="privacy-icon bg-primary-subtle
                                    text-primary">

                            <i class="bi bi-person-heart"></i>

                        </div>

                        <h6 class="fw-bold mt-3">
                            Patient Information
                        </h6>

                        <p class="text-muted small mb-0">

                            Basic patient information such as
                            name, age, gender, phone number,
                            email and profile image may be
                            stored in the system.

                        </p>

                    </div>

                </div>



                <div class="col-md-6 col-lg-3">

                    <div class="privacy-item h-100">

                        <div class="privacy-icon bg-success-subtle
                                    text-success">

                            <i class="bi bi-person-badge"></i>

                        </div>

                        <h6 class="fw-bold mt-3">
                            Doctor Information
                        </h6>

                        <p class="text-muted small mb-0">

                            Doctor profile information including
                            name, speciality, contact information
                            and profile image may be stored.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="privacy-item h-100">

                        <div class="privacy-icon bg-warning-subtle
                                    text-warning">

                            <i class="bi bi-file-medical"></i>

                        </div>

                        <h6 class="fw-bold mt-3">
                            Prescription Data
                        </h6>

                        <p class="text-muted small mb-0">

                            Prescription information may include
                            diagnosis, clinical notes, medicines,
                            tests and treatment instructions.

                        </p>

                    </div>

                </div>


                <div class="col-md-6 col-lg-3">

                    <div class="privacy-item h-100">

                        <div class="privacy-icon bg-info-subtle
                                    text-info">

                            <i class="bi bi-person-lock"></i>

                        </div>

                        <h6 class="fw-bold mt-3">
                            Account Information
                        </h6>

                        <p class="text-muted small mb-0">

                            User accounts contain login-related
                            information required for secure
                            authentication and authorization.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-shield-check text-success me-2"></i>

                Role-Based Access Control

            </h5>

            <p class="text-muted">

                The system uses role-based access control to
                restrict access to different parts of the
                application.

            </p>


            <div class="row g-3">


                <div class="col-md-4">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="d-flex align-items-center mb-2">

                            <i class="bi bi-person-gear
                                      text-danger
                                      fs-4
                                      me-2"></i>

                            <strong>
                                Administrator
                            </strong>

                        </div>

                        <p class="small text-muted mb-0">

                            Manages doctors, patients,
                            prescriptions and system
                            administration.

                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="d-flex align-items-center mb-2">

                            <i class="bi bi-person-badge
                                      text-success
                                      fs-4
                                      me-2"></i>

                            <strong>
                                Doctor
                            </strong>

                        </div>

                        <p class="small text-muted mb-0">

                            Can access permitted doctor
                            functionality and manage
                            authorized prescription data.

                        </p>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="d-flex align-items-center mb-2">

                            <i class="bi bi-person
                                      text-primary
                                      fs-4
                                      me-2"></i>

                            <strong>
                                Patient
                            </strong>

                        </div>

                        <p class="small text-muted mb-0">

                            Can access their own profile and
                            authorized prescription
                            information.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-lock text-primary me-2"></i>

                Account & Security

            </h5>


            <div class="list-group list-group-flush">


                <div class="list-group-item px-0">

                    <i class="bi bi-check-circle-fill
                              text-success
                              me-2"></i>

                    User authentication is handled through
                    ASP.NET Core Identity.

                </div>


                <div class="list-group-item px-0">

                    <i class="bi bi-check-circle-fill
                              text-success
                              me-2"></i>

                    Password policies and account lockout
                    mechanisms help protect user accounts.

                </div>


                <div class="list-group-item px-0">

                    <i class="bi bi-check-circle-fill
                              text-success
                              me-2"></i>

                    Access to protected areas requires
                    appropriate authorization.

                </div>


                <div class="list-group-item px-0">

                    <i class="bi bi-check-circle-fill
                              text-success
                              me-2"></i>

                    Users should never share their passwords
                    with other people.

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-archive text-warning me-2"></i>

                Deleted Information

            </h5>

            <p class="text-muted mb-0">

                When supported records are deleted by an
                administrator, the system may use a
                <strong>soft delete</strong> mechanism.

                This means that the record can be marked as
                deleted rather than immediately removed from
                the database.

                Authorized administrators may restore such
                records when appropriate.

            </p>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">

                <i class="bi bi-share text-primary me-2"></i>

                Data Sharing

            </h5>

            <p class="text-muted mb-0">

                Information stored in the system should only
                be accessed by authorized users according to
                their assigned roles and permissions.

                Medical and personal information should not be
                shared outside the intended healthcare
                workflow without appropriate authorization.

            </p>

        </div>

    </div>



    <div class="alert alert-warning border-0 shadow-sm">

        <div class="d-flex">

            <i class="bi bi-exclamation-triangle-fill
                      fs-4
                      me-3"></i>

            <div>

                <h6 class="fw-bold">
                    Important Notice
                </h6>

                <p class="mb-0 small">

                    This privacy page describes how this
                    application is designed to handle
                    information. It does not replace any
                    applicable privacy law, organizational
                    policy, medical regulation or official
                    legal privacy notice.

                </p>

            </div>

        </div>

    </div>


    <div class="mt-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Home

        </a>

    </div>

</div>