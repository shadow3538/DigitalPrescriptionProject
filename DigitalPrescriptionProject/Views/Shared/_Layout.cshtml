<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Digital Prescription
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/DigitalPrescriptionProject.styles.css"
          asp-append-version="true" />

</head>


<body>


    <header>

        <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">

            <div class="container-fluid px-3 px-lg-4">


                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">

                        <i class="bi bi-heart-pulse-fill"></i>

                    </span>

                    <span>

                        <span class="brand-title">
                            Digital Prescription
                        </span>

                        <small class="brand-subtitle d-none d-md-block">
                            Healthcare Management System
                        </small>

                    </span>

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <li class="nav-item">

                            <a class="nav-link app-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home

                            </a>

                        </li>


                        @if (User.IsInRole("Admin"))
                        {

                            <li class="nav-item">

                                <a class="nav-link app-nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Dashboard

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link app-nav-link"
                                   asp-controller="Doctor"
                                   asp-action="Index">

                                    <i class="bi bi-person-badge me-1"></i>
                                    Doctors

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link app-nav-link"
                                   asp-controller="Patient"
                                   asp-action="Index">

                                    <i class="bi bi-people me-1"></i>
                                    Patients

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link app-nav-link"
                                   asp-controller="Prescription"
                                   asp-action="Index">

                                    <i class="bi bi-file-earmark-medical me-1"></i>
                                    Prescriptions

                                </a>

                            </li>

                        }

                       @if (User.IsInRole("Doctor"))
{


    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Doctor"
           asp-action="Dashboard">

            <i class="bi bi-speedometer2 me-1"></i>

            Dashboard

        </a>

    </li>



    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Doctor"
           asp-action="Index">

            <i class="bi bi-person-circle me-1"></i>

            My Profile

        </a>

    </li>



    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Prescription"
           asp-action="Index">

            <i class="bi bi-file-earmark-medical me-1"></i>

            My Prescriptions

        </a>

    </li>

}


                        @if (User.IsInRole("Patient"))
{

    <!-- PATIENT DASHBOARD -->

    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Patient"
           asp-action="Dashboard">

            <i class="bi bi-speedometer2 me-1"></i>

            Dashboard

        </a>

    </li>


    <!-- PATIENT PROFILE -->

    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Patient"
           asp-action="Index">

            <i class="bi bi-person-circle me-1"></i>

            My Profile

        </a>

    </li>


    <!-- PATIENT PRESCRIPTIONS -->

    <li class="nav-item">

        <a class="nav-link app-nav-link"
           asp-controller="Prescription"
           asp-action="Index">

            <i class="bi bi-file-earmark-medical me-1"></i>

            My Prescriptions

        </a>

    </li>

}

                    </ul>


                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>


    <main class="app-main">

        <div class="container-fluid px-3 px-lg-4">

            @RenderBody()

        </div>

    </main>



    <footer class="app-footer">

        <div class="container-fluid px-3 px-lg-4">

            <div class="row align-items-center gy-2">

                <div class="col-md-6">

                    <div class="footer-brand">

                        <i class="bi bi-heart-pulse-fill me-1"></i>

                        Digital Prescription

                    </div>

                    <small>
                        Healthcare Management System
                    </small>

                </div>


                <div class="col-md-6 text-md-end">

                    <small>

                        &copy; Digital Prescription Project & created by Abdul Malek

                        <span class="mx-1">•</span>

                        <a asp-controller="Home"
                           asp-action="Privacy">

                            Privacy

                        </a>

                    </small>

                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/jquery-ajax-unobtrusive/jquery.unobtrusive-ajax.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>