@model IEnumerable<DigitalPrescriptionProject.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-medical text-primary me-2"></i>
                Prescriptions
            </h2>

            <p class="text-muted mb-0">
                Manage all patient prescriptions
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create New
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1 fw-semibold">
                        Prescription List
                    </h5>

                    <small class="text-muted">
                        All prescriptions and patient information
                    </small>
                </div>

                <span class="badge bg-primary">
                    @(Model?.Count() ?? 0) Records
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Visit Date
                            </th>

                            <th>
                                Patient
                            </th>

                            <th>
                                Doctor
                            </th>

                            <th>
                                Diagnosis
                            </th>

                            <th>
                                Clinical Notes
                            </th>

                            <th class="text-center">
                                Medicine
                            </th>

                            <th class="text-center">
                                Tests
                            </th>

                            <th class="text-center pe-4" style="width: 210px;">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @item.VisitDate.ToString("dd MMM yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @item.VisitDate.ToString("dddd")
                                        </small>
                                    </td>

                                    <td>
                                        @if (item.Patient != null)
                                        {
                                            <div class="d-flex align-items-center">

                                                <div class="rounded-circle bg-primary-subtle
                                                    text-primary d-flex
                                                    align-items-center
                                                    justify-content-center me-2"
                                                     style="width:38px;height:38px;">

                                                    <i class="bi bi-person"></i>

                                                </div>

                                                <div>
                                                    <div class="fw-semibold">
                                                        @item.Patient.FullName
                                                    </div>

                                                    <small class="text-muted">
                                                        Patient
                                                    </small>
                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Doctor != null)
                                        {
                                            <div class="fw-semibold">
                                                <i class="bi bi-person-badge
                                                text-success me-1"></i>

                                                @item.Doctor.FullName
                                            </div>

                                            <small class="text-muted">
                                                Doctor
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }
                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Diagnosis))
                                        {
                                            <span class="text-dark">
                                                @item.Diagnosis
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <td style="max-width:220px;">

                                        @if (!string.IsNullOrWhiteSpace(item.ClinicalNotes))
                                        {
                                            <span class="text-muted"
                                                  title="@item.ClinicalNotes">

                                                @item.ClinicalNotes

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        <span class="badge rounded-pill
                                            bg-success-subtle
                                            text-success px-3 py-2">

                                            <i class="bi bi-capsule me-1"></i>

                                            @(item.PrescriptionItems?.Count ?? 0)

                                        </span>

                                    </td>


                                    <td class="text-center">

                                        <span class="badge rounded-pill
                                            bg-info-subtle
                                            text-info px-3 py-2">

                                            <i class="bi bi-clipboard2-check me-1"></i>

                                            @(item.PrescribedTests?.Count ?? 0)

                                        </span>

                                    </td>

                                    <td class="text-center pe-4">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.PrescriptionId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>
                                                Details

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.PrescriptionId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Prescription">

                                                <i class="bi bi-pencil-square"></i>
                                                Edit

                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-id="@item.PrescriptionId"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Delete Prescription">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {

                            <tr>

                                <td colspan="8" class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-file-medical
                                        display-4 d-block mb-3"></i>

                                        <h5>
                                            No prescriptions found
                                        </h5>

                                        <p class="mb-3">
                                            There are no prescriptions available yet.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Create First Prescription

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>