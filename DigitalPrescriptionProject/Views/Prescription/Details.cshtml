@model DigitalPrescriptionProject.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-file-medical text-primary me-2"></i>
                Prescription Details
            </h2>
            <p class="text-muted mb-0">
                View complete prescription information
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model?.PrescriptionId"
               class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Prescription
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Prescription Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="text-muted small" >
                        Prescription Id
                    </div>
                    <div class="fw-semibold">
                        @Model?.PrescriptionId
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Visit Date
                    </div>
                    <div class="fw-semibold">
                        @Model?.VisitDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Status
                    </div>
                    <span class="badge bg-success">
                        Active
                    </span>
                </div>

            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-primary">
                        <i class="bi bi-person-heart me-2"></i>
                        Patient Information
                    </h5>
                </div>

                <div class="card-body">


                    <div>
                        <label class="text-muted small">
                            Patient
                        </label>
                        <div class="fw-semibold">
                            @Model?.Patient.FullName
                        </div>
                    </div>


                    <div class="mb-3">
                        <label class="text-muted small">
                            Phone Number
                        </label>
                        <div class="fw-semibold">
                            @Model?.Patient.Phone
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-success">
                        <i class="bi bi-person-badge me-2"></i>
                        Doctor Information
                    </h5>
                </div>

                <div class="card-body">

                    

                    <div>
                        <label class="text-muted small">
                            Doctor
                        </label>
                        <div class="fw-semibold">
                            @Model?.Doctor.FullName
                        </div>
                    </div>


                    <div class="mb-3">
                        <label class="text-muted small">
                            Phone Number
                        </label>
                        <div class="fw-semibold">
                            @Model?.Doctor.Phone
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-warning-subtle">
            <h5 class="mb-0">
                <i class="bi bi-clipboard2-pulse me-2"></i>
                Clinical Information
            </h5>
        </div>

        <div class="card-body">

            <div class="mb-4">
                <h6 class="text-muted">
                    Diagnosis
                </h6>

                <div class="p-3 bg-light rounded">
                    @if (!string.IsNullOrWhiteSpace(Model?.Diagnosis))
                    {
                        @Model.Diagnosis
                    }
                    else
                    {
                        <span class="text-muted">
                            No diagnosis recorded.
                        </span>
                    }
                </div>
            </div>

            <div>
                <h6 class="text-muted">
                    Clinical Notes
                </h6>

                <div class="p-3 bg-light rounded">
                    @if (!string.IsNullOrWhiteSpace(Model?.ClinicalNotes))
                    {
                        @Model.ClinicalNotes
                    }
                    else
                    {
                        <span class="text-muted">
                            No clinical notes available.
                        </span>
                    }
                </div>
            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="bi bi-capsule me-2"></i>
                Prescribed Medicines
            </h5>
        </div>

        <div class="card-body">

            @if (Model?.PrescriptionItems != null &&
                 Model.PrescriptionItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Medicine</th>
                                <th>Dosage</th>
                                <th>Time</th>
                                <th>Duration</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var count = 1;
                            }

                            @foreach (var i in Model.PrescriptionItems)
                            {
                                <tr>
                                    <td>@count</td>

                                    <td>
                                        <span class="fw-semibold">
                                            @i.MedicineName
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">
                                            @i.Dosage
                                        </span>
                                    </td>

                                    <td>@i.Time</td>

                                    <td>@i.Duration</td>
                                </tr>

                                count++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-capsule fs-2 d-block mb-2"></i>
                    No medicines prescribed.
                </div>
            }

        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <i class="bi bi-clipboard2-check me-2"></i>
                Prescribed Tests
            </h5>
        </div>

        <div class="card-body">

            @if (Model?.PrescribedTests != null && Model.PrescribedTests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Test Name</th>
                                <th>Instruction</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var testCount = 1;
                            }

                            @foreach (var test in Model.PrescribedTests)
                            {
                                <tr>
                                    <td>@testCount</td>

                                    <td>
                                        <span class="fw-semibold text-dark">
                                            @test.TestName
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(test.Instruction))
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis fw-medium px-2 py-1">
                                                @test.Instruction
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                </tr>

                                testCount++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-clipboard-x fs-2 d-block mb-2"></i>
                    No tests prescribed.
                </div>
            }

        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Prescriptions
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model?.PrescriptionId"
           class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>
            Edit
        </a>

    </div>

</div>