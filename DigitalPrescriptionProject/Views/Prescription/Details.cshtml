@model DigitalPrescriptionProject.Models.Prescription

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container-fluid py-4">


    <div class="prescription-print-header">

        <div class="text-center border-bottom pb-3 mb-4">

            <h1 class="fw-bold mb-1">
                DIGITAL PRESCRIPTION
            </h1>

            <div class="text-muted">
                Healthcare Management System
            </div>

            <div class="mt-2 fw-bold">
                Prescription No:
                @Model.PrescriptionNumber
            </div>

        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-file-medical text-primary me-2"></i>

                Prescription Details

            </h2>

            <p class="text-muted mb-0">
                View complete prescription information
            </p>

        </div>



        <div class="no-print">


            <button type="button"
                    class="btn btn-success"
                    onclick="window.print()">

                <i class="bi bi-printer me-1"></i>

                Print / Save PDF

            </button>



            @if (User.IsInRole("Admin") ||
                 User.IsInRole("Doctor"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.PrescriptionId"
                   class="btn btn-primary ms-2">

                    <i class="bi bi-pencil-square me-1"></i>

                    Edit Prescription

                </a>
            }


            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">

                <i class="bi bi-arrow-left me-1"></i>

                Back

            </a>

        </div>

    </div>



    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-info-circle me-2"></i>

                Prescription Information

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-4">



                <div class="col-md-4">

                    <div class="text-muted small">
                        Prescription Number
                    </div>

                    <div class="fw-bold text-primary fs-5">
                        @Model.PrescriptionNumber
                    </div>

                </div>



                <div class="col-md-4">

                    <div class="text-muted small">
                        Visit Date
                    </div>

                    <div class="fw-semibold">

                        @Model.VisitDate.ToString("dd MMM yyyy")

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="text-muted small">
                        Status
                    </div>

                    <span class="badge bg-success">
                        Active
                    </span>

                </div>

            </div>

        </div>

    </div>



    <div class="row g-4 mb-4">



        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">

                    <h5 class="mb-0 text-primary">

                        <i class="bi bi-person-heart me-2"></i>

                        Patient Information

                    </h5>

                </div>


                <div class="card-body">


                    <div class="mb-3">

                        <label class="text-muted small">
                            Patient
                        </label>

                        <div class="fw-semibold">

                            @(Model.Patient?.FullName ?? "N/A")

                        </div>

                    </div>


                    <div>

                        <label class="text-muted small">
                            Phone Number
                        </label>

                        <div class="fw-semibold">

                            @(Model.Patient?.Phone ?? "N/A")

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-light">

                    <h5 class="mb-0 text-success">

                        <i class="bi bi-person-badge me-2"></i>

                        Doctor Information

                    </h5>

                </div>


                <div class="card-body">


                    <div class="mb-3">

                        <label class="text-muted small">
                            Doctor
                        </label>

                        <div class="fw-semibold">

                            @(Model.Doctor?.FullName ?? "N/A")

                        </div>

                    </div>


                    <div>

                        <label class="text-muted small">
                            Phone Number
                        </label>

                        <div class="fw-semibold">

                            @(Model.Doctor?.Phone ?? "N/A")

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-warning-subtle">

            <h5 class="mb-0">

                <i class="bi bi-clipboard2-pulse me-2"></i>

                Clinical Information

            </h5>

        </div>


        <div class="card-body">



            <div class="mb-4">

                <h6 class="text-muted">
                    Diagnosis
                </h6>

                <div class="p-3 bg-light rounded">

                    @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
                    {
                        @Model.Diagnosis
                    }
                    else
                    {
                        <span class="text-muted">
                            No diagnosis recorded.
                        </span>
                    }

                </div>

            </div>



            <div>

                <h6 class="text-muted">
                    Clinical Notes
                </h6>

                <div class="p-3 bg-light rounded">

                    @if (!string.IsNullOrWhiteSpace(Model.ClinicalNotes))
                    {
                        @Model.ClinicalNotes
                    }
                    else
                    {
                        <span class="text-muted">
                            No clinical notes available.
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>



    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="bi bi-capsule me-2"></i>

                Prescribed Medicines

            </h5>

        </div>


        <div class="card-body">

            @if (Model.PrescriptionItems != null &&
                 Model.PrescriptionItems.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>#</th>

                                <th>Medicine</th>

                                <th>Dosage</th>

                                <th>Time</th>

                                <th>Duration</th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var count = 1;
                            }


                            @foreach (var item in Model.PrescriptionItems)
                            {

                                <tr>

                                    <td>
                                        @count
                                    </td>


                                    <td>

                                        <span class="fw-semibold">
                                            @item.MedicineName
                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge bg-primary-subtle text-primary">

                                            @item.Dosage

                                        </span>

                                    </td>


                                    <td>
                                        @item.Time
                                    </td>


                                    <td>
                                        @item.Duration
                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-4 text-muted">

                    <i class="bi bi-capsule fs-2 d-block mb-2"></i>

                    No medicines prescribed.

                </div>

            }

        </div>

    </div>



<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-info text-white">

        <h5 class="mb-0">

            <i class="bi bi-clipboard2-check me-2"></i>

            Prescribed Tests

        </h5>

    </div>


    <div class="card-body">

        @if (Model.PrescribedTests != null &&
             Model.PrescribedTests.Any())
        {

            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>

                            <th>Test Name</th>

                            <th>Instruction</th>

                            <th>Result</th>

                            <th>Report Date</th>

                            <th class="text-end no-print">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var testCount = 1;
                        }


                        @foreach (
                            var test
                            in Model.PrescribedTests)
                        {

                            <tr>

                                <td>
                                    @testCount
                                </td>


                                <td>

                                    <span class="fw-semibold">

                                        @test.TestName

                                    </span>

                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        test.Instruction))
                                    {
                                        <span class="badge
                                                     bg-info-subtle
                                                     text-info-emphasis">

                                            @test.Instruction

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            N/A
                                        </span>
                                    }

                                </td>



                                <td>

                                    @if (test.TestResult != null)
                                    {
                                        <div>

                                            <span class="fw-bold
                                                         text-success">

                                                @test.TestResult.ResultValue

                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(
                                                test.TestResult.Unit))
                                            {
                                                <span class="text-muted">

                                                    @test.TestResult.Unit

                                                </span>
                                            }

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            test.TestResult.ReferenceRange))
                                        {
                                            <small class="text-muted">

                                                Ref:
                                                @test.TestResult.ReferenceRange

                                            </small>
                                        }

                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            Pending

                                        </span>
                                    }

                                </td>



                                <td>

    @if (test.TestResult != null)
    {
        @Convert.ToDateTime(
            test.TestResult.ReportDate)
    }
    else
    {
        <span class="text-muted">
            —
        </span>
    }

</td>


                               

                                <td class="text-end no-print">

                                    @if (test.TestResult == null)
                                    {
                                        @if (User.IsInRole("Admin") ||
                                             User.IsInRole("Doctor"))
                                        {
                                            <a asp-controller="TestResult"
                                               asp-action="Create"
                                               asp-route-prescribedTestId="@test.Id"
                                               class="btn btn-sm
                                                      btn-outline-primary">

                                                <i class="bi bi-plus-circle me-1"></i>

                                                Add Result

                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        @if (User.IsInRole("Admin") ||
                                             User.IsInRole("Doctor"))
                                        {
                                            <a asp-controller="TestResult"
                                               asp-action="Edit"
                                               asp-route-id="@test.TestResult.TestResultId"
                                               class="btn btn-sm
                                                      btn-outline-warning">

                                                <i class="bi bi-pencil me-1"></i>

                                                Edit Result

                                            </a>
                                        }
                                    }

                                </td>

                            </tr>

                            testCount++;
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="text-center
                        py-4
                        text-muted">

                <i class="bi bi-clipboard-x
                          fs-2
                          d-block
                          mb-2"></i>

                No tests prescribed.

            </div>

        }

    </div>

</div>


<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-secondary text-white
                d-flex justify-content-between
                align-items-center">

        <h5 class="mb-0">

            <i class="bi bi-folder2-open me-2"></i>

            Medical Documents

        </h5>


        @if (User.IsInRole("Admin") ||
             User.IsInRole("Doctor") ||
             User.IsInRole("Patient"))
        {
            <a asp-controller="MedicalDocument"
               asp-action="Upload"
               asp-route-patientId="@Model.PatientId"
               asp-route-prescriptionId="@Model.PrescriptionId"
               class="btn btn-light btn-sm">

                <i class="bi bi-upload me-1"></i>

                Upload Document

            </a>
        }

    </div>


    <div class="card-body">

        @if (Model.MedicalDocuments != null &&
             Model.MedicalDocuments.Any())
        {

            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Document
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Uploaded
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (
                            var document
                            in Model.MedicalDocuments)
                        {

                            <tr>

                                <td>

                                    <div class="fw-semibold">

                                        @document.OriginalFileName

                                    </div>

                                </td>


                                <td>

                                    <span class="badge bg-info-subtle
                                                 text-info-emphasis">

                                        @document.DocumentType

                                    </span>

                                </td>


                                <td>

                                    @document.UploadedAt

                                </td>


                                <td class="text-end">

                                    <a asp-controller="MedicalDocument"
                                       asp-action="Download"
                                       asp-route-id="@document.MedicalDocumentId"
                                       class="btn btn-sm
                                              btn-outline-primary">

                                        <i class="bi bi-download me-1"></i>

                                        Download

                                    </a>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="text-center
                        text-muted py-4">

                <i class="bi bi-folder-x fs-1
                          d-block mb-2"></i>

                No medical documents uploaded.

            </div>

        }

    </div>

</div>



    <div class="d-flex justify-content-end gap-2 no-print">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Prescriptions

        </a>


        @if (User.IsInRole("Admin") ||
             User.IsInRole("Doctor"))
        {

            <a asp-action="Edit"
               asp-route-id="@Model.PrescriptionId"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Edit

            </a>

        }

    </div>

</div>



<style>

    .prescription-print-header {
        display: none;
    }

    @@media print {

        @@page {
            size: A4;
            margin: 12mm;
        }

        html,
        body {
            background: #ffffff !important;
            color: #000000 !important;
        }

        header,
        footer,
        .no-print {
            display: none !important;
        }

        .app-main {
            margin: 0 !important;
            padding: 0 !important;
        }

        .app-main > .container-fluid {
            padding: 0 !important;
            max-width: 100% !important;
        }

        .container-fluid.py-4 {
            padding: 0 !important;
        }

        .prescription-print-header {
            display: block !important;
        }

        .card {
            box-shadow: none !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
        }

        thead {
            display: table-header-group;
        }

        tr {
            break-inside: avoid;
        }

        .card,
        .row {
            break-inside: avoid;
        }

        a {
            color: #000000 !important;
            text-decoration: none !important;
        }

    }

</style>