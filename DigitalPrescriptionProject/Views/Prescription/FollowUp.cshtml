@model IEnumerable<DigitalPrescriptionProject.Models.Prescription>

@{
    ViewData["Title"] = "Patient Follow Up";
}

<div class="container my-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clock-history me-2"></i>
                Follow Up
            </h2>

            <p class="text-muted mb-0">
                Previous prescriptions of
                <strong>@ViewBag.PatientName</strong>
            </p>
        </div>

        <a asp-controller="Patient"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Patients

        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-file-earmark-medical fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No Previous Prescription
                </h5>

                <p class="text-muted mb-0">
                    This patient does not have any previous prescription.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var prescription in Model)
            {
                <div class="col-12">

                    <div class="card border-0 shadow-sm rounded-3">

                        <div class="card-header bg-primary text-white">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5 class="mb-1">

                                        <i class="bi bi-file-earmark-medical me-2"></i>

                                        Prescription #@prescription.PrescriptionId

                                    </h5>

                                    <small>
                                        Visit Date:
                                        @prescription.VisitDate.ToString("yyyy-MM-dd")
                                    </small>
                                </div>

                                <a asp-controller="Prescription"
                                   asp-action="Details"
                                   asp-route-id="@prescription.PrescriptionId"
                                   class="btn btn-light btn-sm">

                                    <i class="bi bi-eye me-1"></i>
                                    View Details

                                </a>

                            </div>

                        </div>


                        <div class="card-body">

                            <div class="row g-3">

                                <div class="col-md-4">

                                    <div class="border rounded-3 p-3 h-100">

                                        <small class="text-muted">
                                            Doctor
                                        </small>

                                        <div class="fw-semibold mt-1">

                                            @(prescription.Doctor?.FullName
                                                ?? "N/A")

                                        </div>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="border rounded-3 p-3 h-100">

                                        <small class="text-muted">
                                            Diagnosis
                                        </small>

                                        <div class="fw-semibold mt-1">

                                            @prescription.Diagnosis

                                        </div>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="border rounded-3 p-3 h-100">

                                        <small class="text-muted">
                                            Clinical Notes
                                        </small>

                                        <div class="fw-semibold mt-1">

                                            @prescription.ClinicalNotes

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <hr class="my-4" />


                            <!-- Medicines -->
                            <div class="mb-4">

                                <h6 class="fw-bold mb-3">

                                    <i class="bi bi-capsule me-2"></i>
                                    Medicines

                                </h6>


                                @if (prescription.PrescriptionItems != null &&
                                     prescription.PrescriptionItems.Any())
                                {
                                    <div class="table-responsive">

                                        <table class="table table-bordered table-hover align-middle">

                                            <thead class="table-light">

                                                <tr>
                                                    <th>Medicine</th>
                                                    <th>Dosage</th>
                                                    <th>Duration</th>
                                                    <th>Time</th>
                                                </tr>

                                            </thead>

                                            <tbody>

                                                @foreach (var item in prescription.PrescriptionItems)
                                                {
                                                    <tr>

                                                        <td>
                                                            @item.MedicineName
                                                        </td>

                                                        <td>
                                                            @item.Dosage
                                                        </td>

                                                        <td>
                                                            @item.Duration
                                                        </td>

                                                        <td>
                                                            @item.Time
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No medicine prescribed.
                                    </span>
                                }

                            </div>


                            <div>

                                <h6 class="fw-bold mb-3">

                                    <i class="bi bi-clipboard2-pulse me-2"></i>
                                    Tests

                                </h6>


                                @if (prescription.PrescribedTests != null &&
                                     prescription.PrescribedTests.Any())
                                {
                                    <div class="table-responsive">

                                        <table class="table table-bordered table-hover align-middle">

                                            <thead class="table-light">

                                                <tr>
                                                    <th>Test</th>
                                                    <th>Instruction</th>
                                                </tr>

                                            </thead>

                                            <tbody>

                                                @foreach (var test in prescription.PrescribedTests)
                                                {
                                                    <tr>

                                                        <td>
                                                            @test.TestName
                                                        </td>

                                                        <td>
                                                            @test.Instruction
                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No test prescribed.
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

