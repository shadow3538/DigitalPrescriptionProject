@model DigitalPrescriptionProject.Models.Prescription

<div class="table-responsive">

    <table class="table table-bordered
                  table-sm
                  align-middle">

        <thead>

            <tr>


                <th style="width: 90px;">

                    <button type="button"
                            class="btn btn-outline-primary
                                   btn-sm
                                   js-prescription-operation"
                            data-operation="testOperation"
                            data-value="add">

                        <i class="bi bi-plus-circle me-1"></i>

                        Add

                    </button>

                </th>


                <th>
                    Test Name
                </th>


                <th>
                    Instruction
                </th>

            </tr>

        </thead>


        <tbody>

            @for (
                int i = 0;
                i < Model.PrescribedTests.Count;
                i++)
            {
                <tr>


                    <td>

                        <button type="button"
                                class="btn btn-outline-danger
                                       btn-sm
                                       js-prescription-operation"
                                data-operation="testOperation"
                                data-value="delete-@i">

                            <i class="bi bi-trash me-1"></i>

                            Delete

                        </button>

                    </td>



                    <td>

                        <input asp-for="
                            PrescribedTests[i].Id"
                               type="hidden" />


                        <select asp-for="
                            PrescribedTests[i].TestName"
                                asp-items="@Html
                                    .GetEnumSelectList<TestName>()"
                                class="form-select
                                       form-select-sm">

                            <option value="">
                                Select Test
                            </option>

                        </select>


                        <span asp-validation-for="
                            PrescribedTests[i].TestName"
                              class="text-danger">
                        </span>

                    </td>


                    <td>

                        <input asp-for="
                            PrescribedTests[i].Instruction"
                               class="form-control
                                      form-control-sm" />


                        <span asp-validation-for="
                            PrescribedTests[i].Instruction"
                              class="text-danger">
                        </span>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>