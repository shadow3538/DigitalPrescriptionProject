@model DigitalPrescriptionProject.Models.Prescription

@{
    ViewData["Title"] = "Delete Prescription";
}

<div class="container mt-4">

    <div class="card shadow-sm">


        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Delete Prescription
            </h3>

        </div>


        <div class="card-body">


            <div class="alert alert-warning">

                <strong>Warning!</strong>

                Are you sure you want to delete this prescription?

                This action cannot be undone.

            </div>


            <div class="row">


                <div class="col-md-6 mb-3">

                    <strong>
                        Visit Date
                    </strong>

                    <div class="form-control bg-light">

                        @Model.VisitDate.ToString(
                            "dd MMMM yyyy")

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        Patient
                    </strong>

                    <div class="form-control bg-light">

                        @(Model.Patient?.FullName ?? "N/A")

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        Doctor
                    </strong>

                    <div class="form-control bg-light">

                        @(Model.Doctor?.FullName ?? "N/A")

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <strong>
                        Diagnosis
                    </strong>

                    <div class="form-control bg-light">

                        @Model.Diagnosis

                    </div>

                </div>

            </div>


            <div class="mb-3">

                <strong>
                    Clinical Notes
                </strong>

                <div class="form-control bg-light"
                     style="min-height:80px;">

                    @Model.ClinicalNotes

                </div>

            </div>

            @if (Model.PrescriptionItems != null &&
                             Model.PrescriptionItems.Any())
            {

                <div class="mt-4">

                    <h5>
                        Medicines
                    </h5>


                    <div class="table-responsive">

                        <table class="table table-bordered table-striped">

                            <thead>

                                <tr>

                                    <th>
                                        Medicine
                                    </th>

                                    <th>
                                        Dosage
                                    </th>

                                    <th>
                                        Duration
                                    </th>

                                    <th>
                                        Time
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (
                                    var item
                                    in Model.PrescriptionItems)
                                {

                                    <tr>

                                        <td>
                                            @item.MedicineName
                                        </td>

                                        <td>
                                            @item.Dosage
                                        </td>

                                        <td>
                                            @item.Duration
                                        </td>

                                        <td>
                                            @item.Time
                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            }

            @if (Model.PrescribedTests != null &&
                             Model.PrescribedTests.Any())
            {

                <div class="mt-4">

                    <h5>
                        Prescribed Tests
                    </h5>


                    <div class="table-responsive">

                        <table class="table table-bordered table-striped">

                            <thead>

                                <tr>

                                    <th>
                                        Test Name
                                    </th>

                                    <th>
                                        Instruction
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (
                                    var test
                                    in Model.PrescribedTests)
                                {

                                    <tr>

                                        <td>
                                            @test.TestName
                                        </td>

                                        <td>
                                            @test.Instruction
                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            }


            <div class="mt-4">


                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           asp-for="PrescriptionId" />


                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete this prescription?');">

                        <i class="bi bi-trash"></i>

                        Delete Prescription

                    </button>


                    <a asp-action="Index"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </form>

            </div>

        </div>

    </div>

</div>