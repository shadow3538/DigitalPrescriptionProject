@model IEnumerable<DigitalPrescriptionProject.Models.Patient>

@{
    ViewData["Title"] = "Index";
}

<h1>Patients</h1>


<div class="d-flex justify-content-between align-items-center mb-3">

    <div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create"
               class="btn btn-outline-primary">

                <i class="bi bi-person-plus me-1"></i>
                Create New

            </a>
        }
    </div>


    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Deleted"
           class="btn btn-outline-danger">

            <i class="bi bi-trash me-1"></i>
            Deleted Patients

        </a>
    }

</div>


<form asp-action="Index"
      method="get"
      class="row g-2 mb-3">

    <div class="col-md-6">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search patient..." />

    </div>


    <div class="col-auto">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-search me-1"></i>
            Search

        </button>

    </div>


    @if (!string.IsNullOrWhiteSpace(
        ViewBag.Search?.ToString()))
    {
        <div class="col-auto">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-lg me-1"></i>
                Clear

            </a>

        </div>
    }

</form>


<div class="table-responsive rounded rounded-3">

    <table class="table table-hover table-bordered align-middle">

        <thead class="table-dark">

            <tr>

                <th>
                    @Html.DisplayNameFor(
                        model => model.FullName)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.Age)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.Phone)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.Email)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.ImagePath)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.Gender)
                </th>

                <th>
                    @Html.DisplayNameFor(
                        model => model.CreatedAt)
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @Html.DisplayFor(
                            model => item.FullName)
                    </td>


                    <td>
                        @Html.DisplayFor(
                            model => item.Age)
                    </td>


                    <td>
                        @Html.DisplayFor(
                            model => item.Phone)
                    </td>


                    <td>
                        @Html.DisplayFor(
                            model => item.Email)
                    </td>


                    <td>

                        @if (item.ImagePath is not null)
                        {
                            <img src="@item.ImagePath"
                                 class="rounded-circle object-fit-cover mb-2"
                                 width="50"
                                 height="50"
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted">
                                No Image
                            </span>
                        }

                    </td>


                    <td>
                        @Html.DisplayFor(
                            model => item.Gender)
                    </td>


                    <td>
                        @Html.DisplayFor(
                            model => item.CreatedAt)
                    </td>


                    <td style="min-width: 300px;">

                        <div class="d-flex flex-wrap gap-1">

                            <a asp-action="Edit"
                               asp-route-id="@item.PatientId"
                               class="btn btn-sm btn-outline-warning">

                                <i class="bi bi-pencil"></i>
                                Edit

                            </a>


                            <a asp-action="Details"
                               asp-route-id="@item.PatientId"
                               class="btn btn-sm btn-outline-secondary">

                                <i class="bi bi-eye"></i>
                                Details

                            </a>


                            <a asp-controller="Prescription"
                               asp-action="FollowUp"
                               asp-route-patientId="@item.PatientId"
                               class="btn btn-sm btn-outline-info">

                                <i class="bi bi-clock-history"></i>
                                Follow Up

                            </a>


                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.PatientId"
                                   class="btn btn-sm btn-outline-danger">

                                    <i class="bi bi-trash"></i>
                                    Delete

                                </a>
                            }

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


@if (!Model.Any())
{
    <div class="alert alert-info text-center">

        @if (!string.IsNullOrWhiteSpace(
            ViewBag.Search?.ToString()))
        {
            <span>
                No patient found for
                "<strong>@ViewBag.Search</strong>".
            </span>
        }
        else
        {
            <span>
                No patients found.
            </span>
        }

    </div>
}


@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center
        flex-wrap
        gap-1
        mt-4">

        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-pageSize="@ViewBag.PageSize"
               asp-route-search="@ViewBag.Search"
               class="btn btn-outline-secondary btn-sm">

                Previous

            </a>
        }


        @for (
            int i = 1;
            i <= ViewBag.TotalPages;
            i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-pageSize="@ViewBag.PageSize"
               asp-route-search="@ViewBag.Search"
               class="btn @(i == ViewBag.CurrentPage
                                   ? "btn-primary"
                                   : "btn-outline-primary") btn-sm">

        @i

    </a>
}


@if (ViewBag.CurrentPage <
     ViewBag.TotalPages)
{
    <a asp-action="Index"
       asp-route-page="@(ViewBag.CurrentPage + 1)"
       asp-route-pageSize="@ViewBag.PageSize"
       asp-route-search="@ViewBag.Search"
       class="btn btn-outline-secondary btn-sm">

        Next

    </a>
}

</div>
}