@model DigitalPrescriptionProject.Models.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container-fluid py-4">


    <div class="card shadow-sm border-0 rounded-3 mb-4">

        <div class="card-header bg-primary text-white py-3">

            <h4 class="mb-0 fs-5">

                <i class="bi bi-person-badge me-2"></i>

                Patient Profile Details

            </h4>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">



                <div class="col-12 col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath"
                             alt="@Model.FullName"
                             class="img-fluid rounded-circle shadow-sm border p-1 mb-3"
                             style="width:180px;
                                    height:180px;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-circle
                                    d-flex
                                    align-items-center
                                    justify-content-center
                                    mx-auto
                                    mb-3
                                    text-secondary
                                    border"
                             style="width:180px;
                                    height:180px;">

                            <i class="bi bi-person fs-1"></i>

                        </div>
                    }


                    <h5 class="fw-bold mb-2">
                        @Model.FullName
                    </h5>


                    <span class="badge bg-info text-dark">

                        @Model.Gender

                    </span>

                </div>



                <div class="col-12 col-md-8">

                    <dl class="row mb-0">



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-calendar3 me-1"></i>

                            @Html.DisplayNameFor(
                                model => model.Age)

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @Model.Age years

                        </dd>



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-telephone me-1"></i>

                            @Html.DisplayNameFor(
                                model => model.Phone)

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @Model.Phone

                        </dd>



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-envelope me-1"></i>

                            @Html.DisplayNameFor(
                                model => model.Email)

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @(Model.Email ?? "N/A")

                        </dd>



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-calendar-check me-1"></i>

                            @Html.DisplayNameFor(
                                model => model.CreatedAt)

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @Model.CreatedAt

                        </dd>



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-file-medical me-1"></i>

                            Total Prescriptions

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @(Model.Prescriptions?.Count ?? 0)

                        </dd>



                        <dt class="col-sm-4 text-muted mb-3">

                            <i class="bi bi-folder2-open me-1"></i>

                            Medical Documents

                        </dt>

                        <dd class="col-sm-8 fw-semibold mb-3">

                            @(Model.MedicalDocuments?.Count ?? 0)

                        </dd>

                    </dl>

                </div>

            </div>

        </div>



        <div class="card-footer bg-light
                    d-flex
                    justify-content-between
                    align-items-center
                    py-3">

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4">

                <i class="bi bi-arrow-left me-1"></i>

                Back to List

            </a>


            <div>

                <a asp-action="Edit"
                   asp-route-id="@Model.PatientId"
                   class="btn btn-warning text-white px-4">

                    <i class="bi bi-pencil me-1"></i>

                    Edit

                </a>

            </div>

        </div>

    </div>



    <div class="card shadow-sm border-0 rounded-3 mb-4">

        <div class="card-header bg-secondary text-white
                    d-flex
                    justify-content-between
                    align-items-center">

            <h5 class="mb-0">

                <i class="bi bi-folder2-open me-2"></i>

                Medical Documents

            </h5>


            @if (User.IsInRole("Admin") ||
                 User.IsInRole("Doctor") ||
                 User.IsInRole("Patient"))
            {
                <a asp-controller="MedicalDocument"
                   asp-action="Upload"
                   asp-route-patientId="@Model.PatientId"
                   class="btn btn-light btn-sm">

                    <i class="bi bi-upload me-1"></i>

                    Upload Document

                </a>
            }

        </div>


        <div class="card-body">

            @if (Model.MedicalDocuments != null &&
                 Model.MedicalDocuments.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Document
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Uploaded
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var documentCount = 1;
                            }


                            @foreach (
                                var document
                                in Model.MedicalDocuments)
                            {

                                <tr>

                                    <td>
                                        @documentCount
                                    </td>


                                    <td>

                                        <div class="fw-semibold">

                                            @document.OriginalFileName

                                        </div>

                                    </td>


                                    <td>

                                        <span class="badge
                                                     bg-info-subtle
                                                     text-info-emphasis">

                                            @document.DocumentType

                                        </span>

                                    </td>


                                    <td>

                                        @document.UploadedAt

                                    </td>


                                    <td class="text-end">

                                        <a asp-controller="MedicalDocument"
                                           asp-action="Download"
                                           asp-route-id="@document.MedicalDocumentId"
                                           class="btn btn-sm
                                                  btn-outline-primary">

                                            <i class="bi bi-download me-1"></i>

                                            Download

                                        </a>

                                    </td>

                                </tr>

                                documentCount++;

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center text-muted py-5">

                    <i class="bi bi-folder-x fs-1
                              d-block mb-3"></i>

                    <h6 class="fw-bold">
                        No Medical Documents
                    </h6>

                    <p class="mb-0">
                        No medical documents have been uploaded
                        for this patient.
                    </p>

                </div>

            }

        </div>

    </div>



    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-success text-white
                    d-flex
                    justify-content-between
                    align-items-center">

            <h5 class="mb-0">

                <i class="bi bi-file-medical me-2"></i>

                Prescription History

            </h5>


            @if (User.IsInRole("Admin") ||
                 User.IsInRole("Doctor"))
            {
                <a asp-controller="Prescription"
                   asp-action="Create"
                   class="btn btn-light btn-sm">

                    <i class="bi bi-plus-circle me-1"></i>

                    New Prescription

                </a>
            }

        </div>


        <div class="card-body p-0">

            @if (Model.Prescriptions != null &&
                 Model.Prescriptions.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Prescription
                                </th>

                                <th>
                                    Doctor
                                </th>

                                <th>
                                    Diagnosis
                                </th>

                                <th>
                                    Visit Date
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var prescription
                                in Model.Prescriptions
                                    .OrderByDescending(
                                        p => p.VisitDate))
                            {

                                <tr>

                                    <td class="ps-4">

                                        <span class="fw-bold text-primary">

                                            @prescription.PrescriptionNumber

                                        </span>

                                    </td>


                                    <td>

                                        Dr.
                                        @(prescription.Doctor?.FullName
                                          ?? "N/A")

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            prescription.Diagnosis))
                                        {
                                            @prescription.Diagnosis
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @prescription.VisitDate

                                    </td>


                                    <td class="text-end pe-4">

                                        <a asp-controller="Prescription"
                                           asp-action="Details"
                                           asp-route-id="@prescription.PrescriptionId"
                                           class="btn btn-sm
                                                  btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center text-muted py-5">

                    <i class="bi bi-file-earmark-x fs-1
                              d-block mb-3"></i>

                    <h6 class="fw-bold">
                        No Prescriptions Found
                    </h6>

                    <p class="mb-0">
                        This patient has no prescription history.
                    </p>

                </div>

            }

        </div>

    </div>

</div>