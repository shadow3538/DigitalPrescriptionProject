@model DigitalPrescriptionProject.Models.Patient

@{
    ViewData["Title"] = "Restore Patient";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>
                        Restore Patient
                    </h5>

                </div>

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Are you sure you want to restore this patient?
                    </h5>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Name
                        </dt>

                        <dd class="col-sm-8">
                            @Model.FullName
                        </dd>


                        <dt class="col-sm-4">
                            Age
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Age
                        </dd>


                        <dt class="col-sm-4">
                            Phone
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Phone
                        </dd>


                        <dt class="col-sm-4">
                            Email
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Email
                        </dd>


                        <dt class="col-sm-4">
                            Deleted At
                        </dt>

                        <dd class="col-sm-8">
                            @Model.DeletedAt?.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                    <hr />

                    <form asp-action="Restore" method="post">

                        <input type="hidden"
                               asp-for="PatientId" />

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Restore Patient

                        </button>

                        <a asp-action="Deleted"
                           class="btn btn-outline-secondary ms-2">

                            Cancel

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>