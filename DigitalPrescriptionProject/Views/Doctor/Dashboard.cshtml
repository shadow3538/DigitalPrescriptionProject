@model DigitalPrescriptionProject.Models.ViewModels.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container-fluid py-4">


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">


                <div class="col-auto">

                    @if (!string.IsNullOrWhiteSpace(Model.DoctorImage))
                    {
                        <img src="@Model.DoctorImage"
                             alt="@Model.DoctorName"
                             class="rounded-circle object-fit-cover"
                             width="90"
                             height="90" />
                    }
                    else
                    {
                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:90px;height:90px;">

                            <i class="bi bi-person-badge fs-1"></i>

                        </div>
                    }

                </div>



                <div class="col">

                    <div class="text-muted small">
                        Doctor Dashboard
                    </div>

                    <h2 class="fw-bold mb-1">

                        Dr. @Model.DoctorName

                    </h2>

                    <div class="text-muted">

                        <i class="bi bi-heart-pulse me-1"></i>

                        @Model.Speciality

                    </div>

                </div>


                <div class="col-auto">

                    <a asp-controller="Doctor"
                       asp-action="Index"
                       class="btn btn-outline-primary">

                        <i class="bi bi-person-circle me-1"></i>

                        My Profile

                    </a>

                </div>

            </div>

        </div>

    </div>



    <div class="row g-4 mb-4">



        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Total Patients
                            </div>

                            <h2 class="fw-bold text-primary mb-0">

                                @Model.TotalPatients

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-people fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Total Prescriptions
                            </div>

                            <h2 class="fw-bold text-success mb-0">

                                @Model.TotalPrescriptions

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-success-subtle
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-file-medical fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <div class="col-xl-4 col-md-12">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <div class="text-muted small mb-2">
                                Today's Prescriptions
                            </div>

                            <h2 class="fw-bold text-warning mb-0">

                                @Model.TodayPrescriptions

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-warning-subtle
                                    text-warning
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-calendar-check fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0 fw-bold">

                <i class="bi bi-lightning-charge
                          text-warning me-2"></i>

                Quick Actions

            </h5>

        </div>


        <div class="card-body">

            <div class="row g-3">


                <div class="col-md-4">

                    <a asp-controller="Prescription"
                       asp-action="Create"
                       class="text-decoration-none">

                        <div class="border rounded-3 p-4
                                    text-center h-100">

                            <i class="bi bi-file-earmark-plus
                                      text-success fs-1"></i>

                            <h6 class="fw-bold mt-3 mb-1">

                                Create Prescription

                            </h6>

                            <small class="text-muted">

                                Create a new prescription

                            </small>

                        </div>

                    </a>

                </div>



                <div class="col-md-4">

                    <a asp-controller="Prescription"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="border rounded-3 p-4
                                    text-center h-100">

                            <i class="bi bi-file-medical
                                      text-primary fs-1"></i>

                            <h6 class="fw-bold mt-3 mb-1">

                                My Prescriptions

                            </h6>

                            <small class="text-muted">

                                View all your prescriptions

                            </small>

                        </div>

                    </a>

                </div>



                <div class="col-md-4">

                    <a asp-controller="Doctor"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="border rounded-3 p-4
                                    text-center h-100">

                            <i class="bi bi-person-circle
                                      text-info fs-1"></i>

                            <h6 class="fw-bold mt-3 mb-1">

                                My Profile

                            </h6>

                            <small class="text-muted">

                                View your doctor profile

                            </small>

                        </div>

                    </a>

                </div>

            </div>

        </div>

    </div>



    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white
                    d-flex
                    justify-content-between
                    align-items-center">

            <h5 class="mb-0 fw-bold">

                <i class="bi bi-clock-history
                          text-primary me-2"></i>

                Recent Prescriptions

            </h5>


            <a asp-controller="Prescription"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary">

                View All

            </a>

        </div>


        <div class="card-body p-0">

            @if (Model.RecentPrescriptions.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Prescription
                                </th>

                                <th>
                                    Patient
                                </th>

                                <th>
                                    Diagnosis
                                </th>

                                <th>
                                    Visit Date
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var prescription
                                in Model.RecentPrescriptions)
                            {

                                <tr>

                                    <td class="ps-4">

                                        <span class="fw-bold text-primary">

                                            @prescription.PrescriptionNumber

                                        </span>

                                    </td>


                                    <td>

                                        @(prescription.Patient?.FullName
                                          ?? "N/A")

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            prescription.Diagnosis))
                                        {
                                            <span>

                                                @prescription.Diagnosis

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @prescription.VisitDate

                                    </td>


                                    <td class="text-end pe-4">

                                        <a asp-controller="Prescription"
                                           asp-action="Details"
                                           asp-route-id="@prescription.PrescriptionId"
                                           class="btn btn-sm
                                                  btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center text-muted py-5">

                    <i class="bi bi-file-earmark-x
                              fs-1 d-block mb-3"></i>

                    <h6 class="fw-bold">
                        No prescriptions yet
                    </h6>

                    <p class="mb-0">
                        Your recent prescriptions will
                        appear here.
                    </p>

                </div>

            }

        </div>

    </div>

</div>