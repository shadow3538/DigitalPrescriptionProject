@model DigitalPrescriptionProject.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container my-4">
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-success text-white py-3">
            <h4 class="mb-0 fs-5"><i class="bi bi-person-badge-fill me-2"></i>Doctor Profile Details</h4>
        </div>


        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-12 col-md-4 text-center border-end-md">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.FullName" class="img-fluid rounded-circle shadow-sm border p-1 mb-3" style="width: 180px; height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3 text-secondary border" style="width: 180px; height: 180px;">
                            <span class="fs-1">👨‍⚕️</span>
                        </div>
                    }
                    <h5 class="fw-bold mb-1">@Html.DisplayFor(model => model.FullName)</h5>
                    <span class="badge bg-primary text-white px-3 py-2 fs-6 mb-2">
                        @Html.DisplayFor(model => model.Speciality)
                    </span>
                </div>

                <div class="col-12 col-md-8">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.FullName)</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.FullName)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Speciality)</dt>
                        <dd class="col-sm-8 fw-semibold text-success">@Html.DisplayFor(model => model.Speciality)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Age)</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Age) years</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Phone)</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Phone)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                        <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Email)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model?.DoctorId" class="btn btn-warning text-white px-4">
                <i class="bi bi-pencil"></i> Edit
            </a>
        </div>
    </div>
</div>