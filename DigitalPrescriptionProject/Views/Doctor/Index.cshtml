@model IEnumerable<DigitalPrescriptionProject.Models.Doctor>

@if (TempData["DoctorEmail"] != null)
{
    <div class="alert alert-success">
        <h5>Doctor Account Created Successfully</h5>

        <p>
            <strong>Email:</strong>
            @TempData["DoctorEmail"]
        </p>

        <p>
            <strong>Temporary Password:</strong>
            @TempData["TemporaryPassword"]
        </p>

        <hr />

        <p class="mb-0">
            Give these login credentials to the doctor.
            The doctor should change the password after the first login.
        </p>
    </div>
}

@{
    ViewData["Title"] = "Index";
}


<div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="mb-0">
        Doctor List
    </h1>

    <div>
        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Create New

        </a>

        <a asp-action="Deleted"
           class="btn btn-outline-danger ms-2">

            <i class="bi bi-trash me-1"></i>
            Deleted Doctors

        </a>
    </div>

</div>


<form asp-action="Index"
      method="get"
      class="row g-2 mb-4">

    <div class="col-md-6">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search doctor by name, phone or email..." />

    </div>


    <div class="col-auto">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-search me-1"></i>
            Search

        </button>

    </div>


    @if (!string.IsNullOrWhiteSpace(
        ViewBag.Search?.ToString()))
    {
        <div class="col-auto">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-lg me-1"></i>
                Clear

            </a>

        </div>
    }

</form>


@if (!Model.Any())
{
    <div class="alert alert-info text-center">

        @if (!string.IsNullOrWhiteSpace(
            ViewBag.Search?.ToString()))
        {
            <span>
                No doctor found for
                "<strong>@ViewBag.Search</strong>".
            </span>
        }
        else
        {
            <span>
                No doctors found.
            </span>
        }

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-4">

                <div class="card h-100 d-flex flex-column shadow-sm border-0">


                    <div class="card-header bg-white text-center border-bottom-0 pt-3">

                        @if (item.ImagePath is not null)
                        {
                            <img src="@item.ImagePath"
                                 class="rounded-circle object-fit-cover mb-2"
                                 width="80"
                                 height="80"
                                 alt="@item.FullName" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-2"
                                 style="width: 80px; height: 80px;">

                                <i class="bi bi-person fs-1 text-secondary"></i>

                            </div>
                        }


                        <h5 class="fw-bold mb-1">
                            @item.FullName
                        </h5>


                        <span class="badge bg-primary-subtle text-primary fs-6 fw-normal">

                            @item.Speciality

                        </span>

                    </div>


                    <div class="card-body flex-grow-1">

                        <h6 class="text-muted fw-bold">
                            Contacts
                        </h6>


                        <ul class="list-unstyled mb-0 small">

                            <li class="mb-1">

                                <i class="bi bi-envelope me-1 text-muted"></i>

                                @item.Email

                            </li>


                            <li>

                                <i class="bi bi-telephone me-1 text-muted"></i>

                                @item.Phone

                            </li>

                        </ul>

                    </div>


                    <div class="card-footer bg-white border-top-0 pb-3">

                        <div class="d-flex gap-2">

                            <a asp-route-id="@item.DoctorId"
                               asp-action="Edit"
                               class="btn btn-outline-warning w-50">

                                Edit

                            </a>


                            <a asp-action="Delete"
                               asp-route-id="@item.DoctorId"
                               class="btn btn-outline-danger w-50">

                                Delete

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}


@if (ViewBag.TotalPages > 1)
{
    <div class="d-flex justify-content-center flex-wrap gap-1 mt-4">


        @if (ViewBag.CurrentPage > 1)
        {
            <a asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-pageSize="@ViewBag.PageSize"
               asp-route-search="@ViewBag.Search"
               class="btn btn-outline-secondary btn-sm">

                Previous

            </a>
        }


        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-pageSize="@ViewBag.PageSize"
               asp-route-search="@ViewBag.Search"
               class="btn @(i == ViewBag.CurrentPage
                                           ? "btn-primary"
                                           : "btn-outline-primary") btn-sm">

        @i

    </a>
}


@if (ViewBag.CurrentPage < ViewBag.TotalPages)
{
    <a asp-action="Index"
       asp-route-page="@(ViewBag.CurrentPage + 1)"
       asp-route-pageSize="@ViewBag.PageSize"
       asp-route-search="@ViewBag.Search"
       class="btn btn-outline-secondary btn-sm">

        Next

    </a>
}

</div>
}