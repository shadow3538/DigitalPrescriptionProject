@model IEnumerable<DigitalPrescriptionProject.Models.Doctor>

@{
    ViewData["Title"] = "Deleted Doctors";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-x text-danger me-2"></i>
                Deleted Doctors
            </h2>

            <p class="text-muted mb-0">
                Manage deleted doctor accounts
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Doctors

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white">

            <h5 class="mb-0">
                <i class="bi bi-trash me-2"></i>
                Deleted Doctor List
            </h5>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Doctor
                            </th>

                            <th>
                                Speciality
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Deleted At
                            </th>

                            <th class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var doctor in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">

                                            @doctor.FullName

                                        </div>

                                    </td>


                                    <td>

                                        @doctor.Speciality

                                    </td>


                                    <td>

                                        @doctor.Phone

                                    </td>


                                    <td>

                                        @doctor.Email

                                    </td>


                                    <td>

                                        @if (doctor.DeletedAt.HasValue)
                                        {
                                            @doctor.DeletedAt.Value.ToString(
                                                "dd MMM yyyy hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        <a asp-action="Restore"
                                           asp-route-id="@doctor.DoctorId"
                                           class="btn btn-sm btn-outline-success">

                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Restore

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-person-check display-5 d-block mb-3"></i>

                                        <h5>
                                            No deleted doctors
                                        </h5>

                                        <p class="mb-0">
                                            There are currently no deleted doctor accounts.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>