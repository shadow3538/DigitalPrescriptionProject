@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-speedometer2 text-primary me-2"></i>
                Admin Dashboard
            </h2>

            <p class="text-muted mb-0">
                Manage doctors, patients and prescriptions
            </p>
        </div>

        <div>
            <a asp-controller="Admin"
               asp-action="CreateUser"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>
                Create User

            </a>
        </div>

    </div>



    <div class="row g-4 mb-4">


        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-muted mb-2">
                                Total Doctors
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                @ViewBag.TotalDoctors
                            </h2>
                        </div>

                        <div class="rounded-circle bg-success-subtle
                            text-success d-flex
                            align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-person-badge fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-muted mb-2">
                                Total Patients
                            </h6>

                            <h2 class="fw-bold text-primary mb-0">
                                @ViewBag.TotalPatients
                            </h2>
                        </div>

                        <div class="rounded-circle bg-primary-subtle
                            text-primary d-flex
                            align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-people fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-muted mb-2">
                                Total Prescriptions
                            </h6>

                            <h2 class="fw-bold text-danger mb-0">
                                @ViewBag.TotalPrescriptions
                            </h2>
                        </div>

                        <div class="rounded-circle bg-danger-subtle
                            text-danger d-flex
                            align-items-center
                            justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-file-medical fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">


        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-person-badge me-2"></i>
                        Doctor Management
                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-3">


                        <div class="col-6">

                            <a asp-controller="Doctor"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded-3 p-3
                                    text-center h-100
                                    bg-success-subtle">

                                    <i class="bi bi-person-check
                                    text-success fs-2"></i>

                                    <h4 class="fw-bold text-success mt-2 mb-1">
                                        @ViewBag.TotalDoctors
                                    </h4>

                                    <span class="text-dark">
                                        Active Doctors
                                    </span>

                                </div>

                            </a>

                        </div>


                        <div class="col-6">

                            <a asp-controller="Doctor"
                               asp-action="Deleted"
                               class="text-decoration-none">

                                <div class="border rounded-3 p-3
                                    text-center h-100
                                    bg-danger-subtle">

                                    <i class="bi bi-person-x
                                    text-danger fs-2"></i>

                                    <h4 class="fw-bold text-danger mt-2 mb-1">
                                        @ViewBag.DeletedDoctors
                                    </h4>

                                    <span class="text-dark">
                                        Deleted Doctors
                                    </span>

                                </div>

                            </a>

                        </div>


                    </div>


                    <div class="text-center mt-4">

                        <a asp-controller="Doctor"
                           asp-action="Create"
                           class="btn btn-outline-success">

                            <i class="bi bi-person-plus me-1"></i>
                            Create Doctor

                        </a>

                    </div>

                </div>

            </div>

        </div>



        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        Patient Management
                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-3">


                        <div class="col-6">

                            <a asp-controller="Patient"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded-3 p-3
                                    text-center h-100
                                    bg-primary-subtle">

                                    <i class="bi bi-person-check
                                    text-primary fs-2"></i>

                                    <h4 class="fw-bold text-primary mt-2 mb-1">
                                        @ViewBag.TotalPatients
                                    </h4>

                                    <span class="text-dark">
                                        Active Patients
                                    </span>

                                </div>

                            </a>

                        </div>


                        <div class="col-6">

                            <a asp-controller="Patient"
                               asp-action="Deleted"
                               class="text-decoration-none">

                                <div class="border rounded-3 p-3
                                    text-center h-100
                                    bg-danger-subtle">

                                    <i class="bi bi-person-x
                                    text-danger fs-2"></i>

                                    <h4 class="fw-bold text-danger mt-2 mb-1">
                                        @ViewBag.DeletedPatients
                                    </h4>

                                    <span class="text-dark">
                                        Deleted Patients
                                    </span>

                                </div>

                            </a>

                        </div>


                    </div>


                    <div class="text-center mt-4">

                        <a asp-controller="Patient"
                           asp-action="Create"
                           class="btn btn-outline-primary">

                            <i class="bi bi-person-plus me-1"></i>
                            Create Patient

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-12">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <h5 class="fw-bold mb-1">
                                <i class="bi bi-file-medical
                                text-danger me-2"></i>

                                Prescription Management
                            </h5>

                            <p class="text-muted mb-0">
                                Total prescriptions created in the system
                            </p>

                        </div>


                        <div class="text-end">

                            <h2 class="fw-bold text-danger mb-0">
                                @ViewBag.TotalPrescriptions
                            </h2>

                            <small class="text-muted">
                                Prescriptions
                            </small>

                        </div>

                    </div>


                    <hr />


                    <div class="text-end">

                        <a asp-controller="Prescription"
                           asp-action="Index"
                           class="btn btn-outline-danger">

                            <i class="bi bi-eye me-1"></i>
                            View Prescriptions

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>