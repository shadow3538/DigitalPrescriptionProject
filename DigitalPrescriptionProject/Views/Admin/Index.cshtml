@model DigitalPrescriptionProject.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">


    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-speedometer2
                          text-primary me-2"></i>

                Admin Dashboard

            </h2>

            <p class="text-muted mb-0">

                Overview of doctors, patients
                and prescriptions

            </p>

        </div>


        <div>

            <a asp-controller="UserManagement"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>

                Create User

            </a>

        </div>

    </div>


    <div class="row g-4 mb-4">


        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Total Doctors
                            </h6>

                            <h2 class="fw-bold text-success mb-0">

                                @Model.TotalDoctors

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-success-subtle
                                    text-success
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-person-badge fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Total Patients
                            </h6>

                            <h2 class="fw-bold text-primary mb-0">

                                @Model.TotalPatients

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-primary-subtle
                                    text-primary
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-people fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Total Prescriptions
                            </h6>

                            <h2 class="fw-bold text-danger mb-0">

                                @Model.TotalPrescriptions

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-danger-subtle
                                    text-danger
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-file-medical fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex
                                justify-content-between
                                align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Today's Prescriptions
                            </h6>

                            <h2 class="fw-bold text-warning mb-0">

                                @Model.TodayPrescriptions

                            </h2>

                        </div>


                        <div class="rounded-circle
                                    bg-warning-subtle
                                    text-warning
                                    d-flex
                                    align-items-center
                                    justify-content-center"
                             style="width:60px;height:60px;">

                            <i class="bi bi-calendar-check fs-3"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4 mb-4">


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Active Doctors
                            </div>

                            <h4 class="fw-bold text-success mb-0">

                                @Model.ActiveDoctors

                            </h4>

                        </div>

                        <i class="bi bi-person-check
                                  text-success fs-3"></i>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Doctor"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-success">

                            View Doctors

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Active Patients
                            </div>

                            <h4 class="fw-bold text-primary mb-0">

                                @Model.ActivePatients

                            </h4>

                        </div>

                        <i class="bi bi-person-check
                                  text-primary fs-3"></i>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Patient"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-primary">

                            View Patients

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex
                                justify-content-between">

                        <div>

                            <div class="text-muted small">
                                This Month
                            </div>

                            <h4 class="fw-bold text-danger mb-0">

                                @Model.ThisMonthPrescriptions

                            </h4>

                            <small class="text-muted">
                                Prescriptions
                            </small>

                        </div>

                        <i class="bi bi-calendar3
                                  text-danger fs-3"></i>

                    </div>

                    <div class="mt-3">

                        <a asp-controller="Prescription"
                           asp-action="Index"
                           class="btn btn-sm btn-outline-danger">

                            View Prescriptions

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <div class="row g-4 mb-4">


        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-person-badge me-2"></i>

                        Doctor Management

                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-3">


                        <div class="col-6">

                            <a asp-controller="Doctor"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded-3
                                            p-3 text-center
                                            h-100
                                            bg-success-subtle">

                                    <i class="bi bi-person-check
                                              text-success fs-2"></i>

                                    <h4 class="fw-bold
                                               text-success
                                               mt-2 mb-1">

                                        @Model.ActiveDoctors

                                    </h4>

                                    <span class="text-dark">
                                        Active Doctors
                                    </span>

                                </div>

                            </a>

                        </div>



                        <div class="col-6">

                            <a asp-controller="Doctor"
                               asp-action="Deleted"
                               class="text-decoration-none">

                                <div class="border rounded-3
                                            p-3 text-center
                                            h-100
                                            bg-danger-subtle">

                                    <i class="bi bi-person-x
                                              text-danger fs-2"></i>

                                    <h4 class="fw-bold
                                               text-danger
                                               mt-2 mb-1">

                                        @Model.DeletedDoctors

                                    </h4>

                                    <span class="text-dark">
                                        Deleted Doctors
                                    </span>

                                </div>

                            </a>

                        </div>

                    </div>


                    <div class="text-center mt-4">

                        <a asp-controller="Doctor"
                           asp-action="Create"
                           class="btn btn-outline-success">

                            <i class="bi bi-person-plus me-1"></i>

                            Create Doctor

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-primary text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-people me-2"></i>

                        Patient Management

                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="row g-3">


                        <div class="col-6">

                            <a asp-controller="Patient"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded-3
                                            p-3 text-center
                                            h-100
                                            bg-primary-subtle">

                                    <i class="bi bi-person-check
                                              text-primary fs-2"></i>

                                    <h4 class="fw-bold
                                               text-primary
                                               mt-2 mb-1">

                                        @Model.ActivePatients

                                    </h4>

                                    <span class="text-dark">
                                        Active Patients
                                    </span>

                                </div>

                            </a>

                        </div>



                        <div class="col-6">

                            <a asp-controller="Patient"
                               asp-action="Deleted"
                               class="text-decoration-none">

                                <div class="border rounded-3
                                            p-3 text-center
                                            h-100
                                            bg-danger-subtle">

                                    <i class="bi bi-person-x
                                              text-danger fs-2"></i>

                                    <h4 class="fw-bold
                                               text-danger
                                               mt-2 mb-1">

                                        @Model.DeletedPatients

                                    </h4>

                                    <span class="text-dark">
                                        Deleted Patients
                                    </span>

                                </div>

                            </a>

                        </div>

                    </div>


                    <div class="text-center mt-4">

                        <a asp-controller="Patient"
                           asp-action="Create"
                           class="btn btn-outline-primary">

                            <i class="bi bi-person-plus me-1"></i>

                            Create Patient

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-header bg-danger text-white
                    d-flex justify-content-between
                    align-items-center">

            <h5 class="mb-0">

                <i class="bi bi-file-medical me-2"></i>

                Recent Prescriptions

            </h5>


            <a asp-controller="Prescription"
               asp-action="Index"
               class="btn btn-sm btn-light">

                View All

            </a>

        </div>


        <div class="card-body p-0">

            @if (Model.RecentPrescriptions.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover
                                  align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Prescription
                                </th>

                                <th>
                                    Patient
                                </th>

                                <th>
                                    Doctor
                                </th>

                                <th>
                                    Date
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var prescription
                                in Model.RecentPrescriptions)
                            {

                                <tr>

                                    <td class="ps-4">

                                        <span class="fw-bold
                                                     text-primary">

                                            @prescription.PrescriptionNumber

                                        </span>

                                    </td>


                                    <td>

                                        @(prescription.Patient?.FullName
                                          ?? "N/A")

                                    </td>


                                    <td>

                                        @(prescription.Doctor?.FullName
                                          ?? "N/A")

                                    </td>


                                    <td>

                                        @prescription.VisitDate
                                            .ToString("dd MMM yyyy")

                                    </td>


                                    <td class="text-end pe-4">

                                        <a asp-controller="Prescription"
                                           asp-action="Details"
                                           asp-route-id="@prescription.PrescriptionId"
                                           class="btn btn-sm
                                                  btn-outline-primary">

                                            <i class="bi bi-eye"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center
                            text-muted py-5">

                    <i class="bi bi-file-earmark-x
                              fs-1 d-block mb-3"></i>

                    No prescriptions found.

                </div>

            }

        </div>

    </div>



    <div class="row g-4 mt-1">


        <div class="col-md-6">

            <div class="alert alert-success
                        border-0 shadow-sm">

                <i class="bi bi-person-check me-2"></i>

                Active Doctors:
                <strong>
                    @Model.ActiveDoctors
                </strong>

            </div>

        </div>


        <div class="col-md-6">

            <div class="alert alert-primary
                        border-0 shadow-sm">

                <i class="bi bi-people me-2"></i>

                Active Patients:
                <strong>
                    @Model.ActivePatients
                </strong>

            </div>

        </div>

    </div>

</div>